ont-variation-settings:'wdth'_112]","children":"01"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"The business is real and registered"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"We check the CIPC company registration against the trading name, and confirm the business is in good standing. A dealership trading under a name that does not match a registered entity does not get listed."}]]}],["$","li","The paperwork holds up",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"02"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"The paperwork holds up"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"VAT registration where the turnover requires it, and a motor trade number where the dealership holds one. We ask for proof of the trading address, not just a postal one, because an address you cannot visit is not an address."}]]}],["$","li","Industry membership, where they claim it",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"03"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"Industry membership, where they claim it"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"If a dealership displays RMI, NADA, MIWA or SAMBRA membership on their profile, we have seen the certificate. We do not take the badge off a website and repeat it."}]]}],"$L2"]}]]}],"$L3","$L4","$L5"],null,"$L6"]}],"isPartial":"$@7","staleTime":"$8","varyParams":null},{"rsc":"$L9","isPartial":"$@a"