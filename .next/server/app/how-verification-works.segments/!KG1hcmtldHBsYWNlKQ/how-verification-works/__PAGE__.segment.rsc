3:["$","li","A named person signs off, and it is recorded",{"className":"rounded-lg border border-line p-5","children":[["$","$L2",null,{"iconNode":[["path",{"d":"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2","key":"1yyitq"}],["circle",{"cx":"9","cy":"7","r":"4","key":"nufk8"}],["line",{"x1":"17","x2":"22","y1":"8","y2":"13","key":"3nzzx3"}],["line",{"x1":"22","x2":"17","y1":"8","y2":"13","key":"1swrse"}]],"className":"lucide-user-x size-6 text-accent","aria-hidden":"true"}],["$","h3",null,{"className":"mt-3 text-base","children":"A named person signs off, and it is recorded"}],["$","p",null,{"className":"mt-2 text-sm text-ink-secondary","children":"Verification is a decision made by someone at Rynet, not a form that passes itself. Every decision is recorded with who made it, when, and on what evidence, so it can be looked at again."}]]}]
4:["$","section",null,{"aria-labelledby":"not-heading","className":"mt-14","children":[["$","h2",null,{"id":"not-heading","className":"text-2xl","children":"What the badge does not mean"}],["$","div",null,{"className":"measure mt-4 rounded-lg border-2 border-line-interactive p-6","children":[["$","p",null,{"className":"flex items-start gap-3 text-ink-secondary","children":[["$","$L2",null,{"iconNode":[["path",{"d":"m2 2 20 20","key":"1ooewy"}],["path",{"d":"M5 5a1 1 0 0 0-1 1v7c0 5 3.5 7.5 7.67 8.94a1 1 0 0 0 .67.01c2.35-.82 4.48-1.97 5.9-3.71","key":"1jlk70"}],["path",{"d":"M9.309 3.652A12.252 12.252 0 0 0 11.24 2.28a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1v7a9.784 9.784 0 0 1-.08 1.264","key":"18rp1v"}]],"className":"lucide-shield-off mt-0.5 size-5 shrink-0 text-ink-muted","aria-hidden":"true"}],["$","span",null,{"children":[["$","strong",null,{"className":"font-semibold text-ink","children":"We have not inspected the vehicle."}]," ","Verification is about the business, not the car. We have not driven it, put it on a lift, or checked the odometer against the service record."]}]]}],["$","ul",null,{"className":"mt-4 space-y-2 pl-8 text-sm text-ink-secondary","children":[["$","li",null,{"className":"list-disc","children":"We do not check that the mileage, service history or condition on a listing is accurate. The dealership supplies that, and they are responsible for it."}],["$","li",null,{"className":"list-disc","children":"We do not run a finance, accident or stolen-vehicle check on individual cars."}],["$","li",null,{"className":"list-disc","children":"A verified dealership is not a guarantee of a good deal or good service. It is a guarantee that you know who you are dealing with."}]]}],["$","p",null,{"className":"mt-5 text-sm text-ink-secondary","children":"Still get an independent inspection before you buy, and still check the vehicle yourself. Verification means the seller is real and traceable. It does not replace looking at the car."}]]}]]}]
5:["$","section",null,{"aria-labelledby":"ongoing-heading","className":"mt-14","children":[["$","h2",null,{"id":"ongoing-heading","className":"text-2xl","children":"It is not a one-off"}],["$","div",null,{"className":"measure mt-4 space-y-4 text-ink-secondary","children":[["$","p",null,{"children":"A dealership can be suspended, and a suspended one disappears from the site immediately, along with all of its stock. It does not stay up greyed out, because a half-listed business on a platform that promises verification is worse than none."}],["$","p",null,{"children":"We suspend for the obvious reasons: the registration lapses, the business stops trading, or a pattern of complaints suggests the listings are not what they say. We also pull individual listings that look wrong, such as a price far below market, a duplicate VIN, or stock that has sat unchanged for months."}],["$","p",null,{"children":["If you have dealt with a dealership on Rynet and it did not go the way the listing suggested, tell us. That is the main way we find out."," ",["$","$L11",null,{"href":"/contact","children":"Get in touch"}],"."]}]]}]]}]
