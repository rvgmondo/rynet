ership displays RMI, NADA, MIWA or SAMBRA membership on their profile, we have seen the certificate. We do not take the badge off a website and repeat it."}]]}],"$L3"]}]]}],"$L4","$L5","$L6"]}],null,"$L7"]}],"isPartial":"$@8","staleTime":"$9","varyParams":null},{"rsc":"$La","isPartial":"$@b","staleTime":"$9","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$9","varyParams":"$e"}],"isUpgradeableISRFallback":false,"a":"$@f","rootVaryParams":null,"needsRuntimeRequest":"$@10"}
