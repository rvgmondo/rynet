2:["$","li","A named person signs off, and it is recorded",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"04"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"A named person signs off, and it is recorded"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"Verification is a decision made by someone at Rynet, not a form that passes itself. Every decision is recorded with who made it, when, and on what evidence, so it can be looked at again."}]]}]
