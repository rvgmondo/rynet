28:["$","section",null,{"aria-labelledby":"ongoing-heading","className":"mt-14","children":[["$","h2",null,{"id":"ongoing-heading","className":"text-2xl","children":"It is not a one-off"}],["$","div",null,{"className":"measure mt-4 space-y-4 text-ink-secondary","children":[["$","p",null,{"children":"A dealership can be suspended, and a suspended one disappears from the site immediately, along with all of its stock. It does not stay up greyed out, because a half-listed business on a platform that promises verification is worse than none."}],["$","p",null,{"children":"We suspend for the obvious reasons: the registration lapses, the business stops trading, or a pattern of complaints suggests the listings are not what they say. We also pull individual listings that look wrong, such as a price far below market, a duplicate VIN, or stock that has sat unchanged for months."}],["$","p",null,{"children":["If you have dealt with a dealership on Rynet and it did not go the way the listing suggested, tell us. That is the main way we find out."," ",["$","$L5",null,{"href":"/contact","children":"Get in touch"}],"."]}]]}]]}]
