6:["$","section",null,{"aria-labelledby":"checks-heading","className":"container-page py-[var(--section-base)]","children":[["$","h2",null,{"id":"checks-heading","className":"rn-head max-w-[20ch]","children":"What we check before a dealership can list"}],["$","hr",null,{"className":"rn-rule mt-6"}],["$","ol",null,{"className":"mt-2","children":[["$","li","The business is real and registered",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"01"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"The business is real and registered"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"We check the CIPC company registration against the trading name, and confirm the business is in good standing. A dealership trading under a name that does not match a registered entity does not get listed."}]]}],["$","li","The paperwork holds up",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"02"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"The paperwork holds up"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"VAT registration where the turnover requires it, and a motor trade number where the dealership holds one. We ask for proof of the trading address, not just a postal one, because an address you cannot visit is not an address."}]]}],["$","li","Industry membership, where they claim it",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"03"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"Industry membership, where they claim it"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"If a dealership displays RMI, NADA, MIWA or SAMBRA membership on their profile, we have seen the certificate. We do not take the badge off a website and repeat it."}]]}],["$","li","A named person signs off, and it is recorded",{"className":"grid gap-2 border-b border-line py-7 md:grid-cols-[4rem_18rem_1fr] md:gap-8","children":[["$","span",null,{"aria-hidden":"true","className":"font-display text-2xl font-extrabold tabular text-ink-muted [font-variation-settings:'wdth'_112]","children":"04"}],["$","h3",null,{"className":"font-display text-xl font-bold leading-snug","children":"A named person signs off, and it is recorded"}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"Verification is a decision made by someone at Rynet, not a form that passes itself. Every decision is recorded with who made it, when, and on what evidence, so it can be looked at again."}]]}]]}]]}]
7:["$","section",null,{"aria-labelledby":"not-heading","className":"bg-surface-inverse text-ink-inverse","children":["$","div",null,{"className":"container-page py-[var(--section-base)]","children":[["$","h2",null,{"id":"not-heading","className":"rn-head max-w-[14ch]","children":"What the badge does not mean"}],["$","hr",null,{"className":"mt-8 h-px border-0 bg-silver"}],["$","div",null,{"className":"mt-10 grid gap-10 lg:grid-cols-[1.1fr_1fr] lg:gap-16","children":[["$","p",null,{"className":"rn-prose rn-prose--drop text-lg","children":[["$","strong",null,{"className":"font-semibold","children":"We have not inspected the vehicle."}]," ","Verification is about the business, not the car. We have not driven it, put it on a lift, or checked the odometer against the service record."]}],["$","ul",null,{"className":"space-y-0","children":[["$","li","We do not check that the mileage, service history or condition on a listing is accurate. The dealership supplies that, and they are responsible for it.",{"className":"border-t border-silver/40 py-4 text-sm opacity-90","children":"We do not check that the mileage, service history or condition on a listing is accurate. The dealership supplies that, and they are responsible for it."}],["$","li","We do not run a finance, accident or stolen-vehicle check on individual cars.",{"className":"border-t border-silver/40 py-4 text-sm opacity-90","children":"We do not run a finance, accident or stolen-vehicle check on individual cars."}],["$","li","A verified dealership is not a guarantee of a good deal or good service. It is a guarantee that you know who you are dealing with.",{"className":"border-t border-silver/40 py-4 text-sm opacity-90","children":"A verified dealership is not a guarantee of a good deal or good service. It is a guarantee that you know who you are dealing with."}]]}]]}],["$","p",null,{"className":"measure mt-10 text-lg","children":"Still get an independent inspection before you buy, and still check the vehicle yourself. Verification means the seller is real and traceable. It does not replace looking at the car."}]]}]}]
8:["$","section",null,{"aria-labelledby":"ongoing-heading","className":"container-page py-[var(--section-base)]","children":["$","div",null,{"className":"grid gap-8 lg:grid-cols-[1fr_1.4fr] lg:gap-16","children":[["$","h2",null,{"id":"ongoing-heading","className":"rn-head max-w-[10ch]","children":"It is not a one-off"}],["$","div",null,{"className":"space-y-5","children":[["$","p",null,{"className":"rn-prose rn-prose--drop text-ink-secondary","children":"A dealership can be suspended, and a suspended one disappears from the site immediately, along with all of its stock. It does not stay up greyed out, because a half-listed business on a platform that promises verification is worse than none."}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":"We suspend for the obvious reasons: the registration lapses, the business stops trading, or a pattern of complaints suggests the listings are not what they say. We also pull individual listings that look wrong, such as a price far below market, a duplicate VIN, or stock that has sat unchanged for months."}],["$","p",null,{"className":"rn-prose text-ink-secondary","children":["If you have dealt with a dealership on Rynet and it did not go the way the listing suggested, tell us. That is the main way we find out."," ",["$","$L4",null,{"href":"/contact","children":"Get in touch"}],"."]}]]}]]}]}]
9:["$","section",null,{"aria-labelledby":"dealer-heading","className":"container-page pb-[var(--section-base)]","children":[["$","hr",null,{"className":"rn-rule rn-rule--brand"}],["$","div",null,{"className":"mt-10 grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-start","children":[["$","h2",null,{"id":"dealer-heading","className":"rn-head max-w-[12ch]","children":"Run a dealership?"}],["$","div",null,{"children":[["$","p",null,{"className":"rn-prose text-ink-secondary","children":"Verification takes a few days and needs your CIPC registration, proof of your trading address and, where you hold them, your VAT and motor trade numbers."}],["$","$L4",null,{"href":"/contact","className":"rn-label mt-8 inline-flex min-h-12 items-center bg-accent-solid px-6 text-ink-on-accent hover:bg-accent-solid-hover","children":"Apply to list your stock"}]]}]]}]]}]
