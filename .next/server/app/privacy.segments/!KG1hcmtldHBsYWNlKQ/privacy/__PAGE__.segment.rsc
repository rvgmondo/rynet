7:["$","article",null,{"className":"rn-card w-full max-w-[46rem] min-w-0 px-5 py-8 sm:px-10 sm:py-10 lg:px-14 lg:py-12","children":["$","div",null,{"className":"rn-doc rn-links measure break-words [&>h2:first-child]:mt-0 [&>h2:first-child]:border-t-0 [&>h2:first-child]:pt-0","children":[["$","h2",".0",{"children":"Who we are","id":"who-we-are"}],["$","p",".1",{"children":"Rynet is a vehicle marketplace operating in South Africa. In POPIA terms we are the responsible party for the personal information described here."}],["$","p",".2",{"children":[["$","strong",null,{"children":"Information Officer:"}]," to be confirmed and registered with the Information Regulator before launch. Contact:"," ",["$","a",null,{"href":"mailto:privacy@rynet.co.za","children":"privacy@rynet.co.za"}],"."]}],["$","h2",".3",{"children":"What we collect, and why","id":"what-we-collect-and-why"}],["$","h3",".4",{"children":"When you enquire about a vehicle"}],["$","p",".5",{"children":"Your name, email address, phone number and whatever you write in the message. We collect it for one purpose: to pass it to the dealership selling that vehicle so they can respond."}],["$","p",".6",{"children":[["$","strong",null,{"children":"Our lawful basis is your consent"}],", which you give by ticking the box on the enquiry form. We record what you agreed to, word for word, along with the date and the version of this notice that was live at the time. You can withdraw that consent at any time, though we cannot take back an enquiry a dealership has already received."]}],["$","h3",".7",{"children":"When you offer your car to dealerships"}],["$","p",".8",{"children":["Your name, email address and phone number, and the details of your car and where it is. We collect it for one purpose: to pass it to no more than ",5," verified dealerships in your province that buy that kind of car, so they can contact you with an offer."]}],["$","p",".9",{"children":[["$","strong",null,{"children":"Our lawful basis is your consent"}],", recorded word for word with the date, the same way as for an enquiry. Once a dealership has your details it decides for itself what it does with them, and it answers for that use. The full notice is on the"," ",["$","$L13",null,{"href":"/sell-to-a-dealer#popia-heading","children":"sell to a dealership page"}],"."]}],["$","h3",".a",{"children":"When you browse"}],["$","p",".b",{"children":"We keep aggregate counts of how many times a listing was viewed and how many times a phone number was revealed, because dealerships are entitled to know whether their stock is being seen. These counts are not linked to you."}],["$","p",".c",{"children":["Our analytics does not use cookies and does not collect personal information. We chose it for that reason. See the ",["$","$L13",null,{"href":"/cookies","children":"cookie notice"}],"."]}],["$","h3",".d",{"children":"When you create an account"}],["$","p",".e",{"children":"Your email address, name, a hashed password, and the province and city you choose. Buyer accounts exist so you can save vehicles and searches. A buyer account can never list a vehicle, which is a structural property of the platform rather than a setting."}],["$","h2",".f",{"children":"Who we share it with","id":"who-we-share-it-with"}],["$","ul",".g",{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"The dealership selling the vehicle you enquired about."}]," That is the point of the enquiry, and it is what you consented to. We do not pass an enquiry to any other dealership."]}],["$","li",null,{"children":[["$","strong",null,{"children":["If you offer your car to dealerships, no more than ",5," dealerships"]}]," ","in your province that buy that kind of car, as the consent you gave says."]}],"$L14","$L15"]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28"]}]}]
