0:{"buildId":"","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"container-page py-[var(--section-base)]","children":[["$","div",null,{"className":"measure","children":[["$","h1",null,{"className":"text-4xl","children":"Privacy notice"}],["$","p",null,{"className":"mt-4 text-lg text-ink-secondary","children":"What we collect, why, who sees it, and how to get it back. Written under the Protection of Personal Information Act."}],["$","p",null,{"className":"mt-3 text-xs text-ink-muted","children":["Last updated ","26 August 2026"]}]]}],["$","div",null,{"className":"measure mt-10 [&_h2]:mt-10 [&_h2]:text-2xl [&_h3]:mt-8 [&_h3]:text-lg [&_p]:mt-4 [&_p]:text-ink-secondary [&_ul]:mt-4 [&_ul]:space-y-2 [&_ul]:pl-5 [&_li]:list-disc [&_li]:text-ink-secondary [&_ol]:mt-4 [&_ol]:space-y-2 [&_ol]:pl-5 [&_ol_li]:list-decimal [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-accent-hover [&_strong]:font-semibold [&_strong]:text-ink","children":[["$","div",null,{"role":"note","className":"measure mb-8 rounded-lg border-2 border-warning bg-warning-subtle p-4","children":[["$","p",null,{"className":"font-display text-sm font-bold text-warning","children":"Requires legal review"}],["$","p",null,{"className":"mt-1 text-sm text-ink-secondary","children":"This is a plain-language draft written to be cheap for an attorney to review. It has not been reviewed, and it is not legal advice. Do not rely on it, and do not treat this page as final until a South African attorney has signed it off."}]]}],["$","h2",null,{"children":"Who we are"}],["$","p",null,{"children":"Rynet is a vehicle marketplace operating in South Africa. In POPIA terms we are the responsible party for the personal information described here."}],["$","p",null,{"children":[["$","strong",null,{"children":"Information Officer:"}]," to be confirmed and registered with the Information Regulator before launch. Contact:"," ",["$","a",null,{"href":"mailto:privacy@rynet.co.za","children":"privacy@rynet.co.za"}],"."]}],["$","h2",null,{"children":"What we collect, and why"}],["$","h3",null,{"children":"When you enquire about a vehicle"}],["$","p",null,{"children":"Your name, email address, phone number and whatever you write in the message. We collect it for one purpose: to pass it to the dealership selling that vehicle so they can respond."}],["$","p",null,{"children":[["$","strong",null,{"children":"Our lawful basis is your consent"}],", which you give by ticking the box on the enquiry form. We record what you agreed to, word for word, along with the date and the version of this notice that was live at the time. You can withdraw that consent at any time, though we cannot take back an enquiry a dealership has already received."]}],["$","h3",null,{"children":"When you browse"}],["$","p",null,{"children":"We keep aggregate counts of how many times a listing was viewed and how many times a phone number was revealed, because dealerships are entitled to know whether their stock is being seen. These counts are not linked to you."}],["$","p",null,{"children":["Our analytics does not use cookies and does not collect personal information. We chose it for that reason. See the ",["$","$L2",null,{"href":"/cookies","children":"cookie notice"}],"."]}],["$","h3",null,{"children":"When you create an account"}],["$","p",null,{"children":"Your email address, name, a hashed password, and the province and city you choose. Buyer accounts exist so you can save vehicles and searches. A buyer account can never list a vehicle, which is a structural property of the platform rather than a setting."}],["$","h2",null,{"children":"Who we share it with"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"The dealership selling the vehicle you enquired about."}]," That is the point of the enquiry, and it is what you consented to. We do not pass your details to any other dealership."]}],"$L3","$L4"]}],"$L5","$L6","$L7","$L8","$L9","$La","$Lb","$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17"]}]]}],null,"$L18"]}],"isPartial":"$@19","staleTime":"$1a","varyParams":null},{"rsc":"$L1b","isPartial":"$@1c","staleTime":"$1a","varyParams":null},{"rsc":"$L1d","isPartial":"$@1e","staleTime":"$1a","varyParams":"$1f"}],"isUpgradeableISRFallback":false,"a":"$@20","rootVaryParams":null,"needsRuntimeRequest":"$@21"}
