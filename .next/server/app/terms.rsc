f:["$","div",null,{"className":"rn-doc measure","children":[["$","div",".0",{"role":"note","className":"measure mb-12 border-t-2 border-warning pt-5","children":[["$","p",null,{"className":"rn-label text-warning","children":"Requires legal review"}],["$","p",null,{"className":"text-sm text-ink-secondary","children":"This is a plain-language draft written to be cheap for an attorney to review. It has not been reviewed, and it is not legal advice. Do not rely on it, and do not treat this page as final until a South African attorney has signed it off."}]]}],["$","h2",".1",{"children":"What Rynet is","id":"what-rynet-is"}],["$","p",".2",{"children":["Rynet is an advertising platform. Dealerships list vehicles, and buyers find them and get in touch. ",["$","strong",null,{"children":"We are not a party to any sale."}]," We do not own the vehicles, we do not hold the money, and we are not an agent for either side."]}],["$","h2",".3",{"children":"Only dealerships may list","id":"only-dealerships-may-list"}],["$","p",".4",{"children":["Only registered dealerships we have verified may advertise on Rynet. There is no private seller account and no way to create one. See"," ",["$","$L4",null,{"href":"/how-verification-works","children":"how verification works"}],"."]}],["$","h2",".5",{"children":"What we are responsible for","id":"what-we-are-responsible-for"}],["$","p",".6",{"children":"Running the platform, verifying that a listing dealership is a real registered business, and removing listings and dealerships that do not meet the standard."}],["$","h2",".7",{"children":"What we are not responsible for","id":"what-we-are-not-responsible-for"}],["$","ul",".8",{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"The accuracy of a listing."}]," Price, mileage, specification, service history and condition come from the dealership. We do not inspect vehicles."]}],["$","li",null,{"children":[["$","strong",null,{"children":"The sale."}]," Any agreement is between 