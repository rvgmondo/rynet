0:{"buildId":"","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"container-page py-[var(--section-tight)]","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"ProfessionalService\",\"name\":\"Rynet Digital\",\"url\":\"https://rynet.co.za/digital\",\"description\":\"Websites, stock feeds, paid media, local search, photography, lead routing and reporting for South African car dealerships.\",\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Pretoria\",\"addressRegion\":\"Gauteng\",\"addressCountry\":\"ZA\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"South Africa\"},\"audience\":{\"@type\":\"BusinessAudience\",\"name\":\"Car dealerships\"},\"parentOrganization\":{\"@type\":\"Organization\",\"name\":\"Rynet\",\"url\":\"https://rynet.co.za\"}}"}}],[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"About\",\"item\":\"https://rynet.co.za/digital/about\"}]}"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"scroll-x","children":["$","ol",null,{"className":"flex items-center gap-1 whitespace-nowrap text-xs text-ink-muted","children":[["$","li","/digital/about",{"className":"flex items-center gap-1","children":[null,["$","span",null,{"aria-current":"page","className":"truncate text-ink-secondary","children":"About"}]]}]]}]}]],["$","div",null,{"className":"measure mt-6","children":[["$","h1",null,{"className":"text-4xl","children":"About Rynet Digital"}],["$","p",null,{"className":"mt-4 text-lg text-ink-secondary","children":"We work with car dealerships and nobody else, from Pretoria, and we built the marketplace this site sits on."}]]}],["$","section",null,{"aria-labelledby":"only-heading","className":"mt-14","children":[["$","h2",null,{"id":"only-heading","className":"text-2xl","children":"Why only dealerships"}],["$","div",null,{"className":"measure mt-4 space-y-4 text-ink-secondary","children":[["$","p",null,{"children":"A general agency learns your business on your budget. It spends the first two months working out what a derivative is, why a unit at ninety days is a problem, and why the car in the photograph has to be the car you are selling."}],["$","p",null,{"children":"We only take dealerships, so that part is already done. We know what a DMS export looks like, why the stock feed breaks, and what a floor plan costs you every month a unit does not move. That is the whole argument for the restriction, and it is why we will turn down work outside it."}]]}]]}],["$","section",null,{"aria-labelledby":"proof-heading","className":"mt-14","children":[["$","h2",null,{"id":"proof-heading","className":"text-2xl","children":"What we have actually built"}],["$","div",null,{"className":"measure mt-4 space-y-4 text-ink-secondary","children":[["$","p",null,{"children":[["$","$L2",null,{"href":"/","className":"font-semibold text-accent hover:underline","children":"Rynet Showroom"}],", the marketplace on this domain. Search across hundreds of listings, dealership pages, vehicle pages with finance estimates, enquiry handling with POPIA consent recorded properly, and structured data throughout. Built to WCAG 2.2 AA with automated checks that fail the build rather than an audit at the end."]}],["$","p",null,{"children":"You can open it and judge it, which is the point. It is the reason there is no case study section on this site: we have not done client work yet, so a case study would be invented, and we would rather show you something real than describe something that is not."}]]}]]}],["$","section",null,{"aria-labelledby":"conflict-heading","className":"mt-14","children":[["$","h2",null,{"id":"conflict-heading","className":"text-2xl","children":"The obvious conflict, addressed"}],"$L3"]}],"$L4","$L5"]}],null,"$L6"]}],"isPartial":"$@7",