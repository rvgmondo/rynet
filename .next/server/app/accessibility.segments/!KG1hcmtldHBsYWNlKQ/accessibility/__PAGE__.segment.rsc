0:{"buildId":"","data":[{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"container-page py-[var(--section-base)]","children":[["$","div",null,{"className":"measure","children":[["$","h1",null,{"className":"text-4xl","children":"Accessibility"}],["$","p",null,{"className":"mt-4 text-lg text-ink-secondary","children":"We are building Rynet to WCAG 2.2 Level AA. Here is where it actually stands, including what has not been tested yet."}],["$","p",null,{"className":"mt-3 text-xs text-ink-muted","children":["Last updated ","26 August 2026"]}]]}],["$","div",null,{"className":"measure mt-10 [&_h2]:mt-10 [&_h2]:text-2xl [&_h3]:mt-8 [&_h3]:text-lg [&_p]:mt-4 [&_p]:text-ink-secondary [&_ul]:mt-4 [&_ul]:space-y-2 [&_ul]:pl-5 [&_li]:list-disc [&_li]:text-ink-secondary [&_ol]:mt-4 [&_ol]:space-y-2 [&_ol]:pl-5 [&_ol_li]:list-decimal [&_a]:text-accent [&_a]:underline [&_a]:underline-offset-2 hover:[&_a]:text-accent-hover [&_strong]:font-semibold [&_strong]:text-ink","children":[["$","h2",null,{"children":"What is tested automatically, on every change"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"axe-core"}]," runs against every page template on desktop and mobile. Zero violations is the pass mark, and a single one fails the build."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Colour contrast"}]," is computed from the design tokens rather than eyeballed. Every foreground and background pair in both themes is checked against the relevant WCAG threshold, and a change that breaks one fails the build."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Layout from 320px to 1920px"}],", checking that nothing ever forces the page to scroll sideways."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Both colour themes"}],", including with JavaScript disabled."]}]]}],["$","h2",null,{"children":"Built in from the start"}],["$","ul",null,{"children":[["$","li",null,{"children":"Semantic HTML first. ARIA only where semantics genuinely fall short."}],["$","li",null,{"children":"Everything operable by keyboard, with a focus ring that stays visible on any background."}],["$","li",null,{"children":"A skip link, so you are not tabbing through the whole header on every page."}],["$","li",null,{"children":"Every form field has a persistent visible label. Placeholders are never used as labels, because they vanish the moment you start typing."}],["$","li",null,{"children":"Errors are announced, tied to their field, and say what to do about it."}],["$","li",null,{"children":"Touch targets are at least 44 by 44 pixels."}],["$","li",null,{"children":"Result counts are announced when they change."}],["$","li",null,{"children":"Reduced motion is honoured, and reduced does not mean broken: nothing disappears and no state becomes unreachable."}],["$","li",null,{"children":"Status is never carried by colour alone. Every coloured state has an icon or a label."}]]}],["$","h2",null,{"children":"What is not done yet"}],["$","p",null,{"children":"Being straight about this is the point of the page. As at the date above:"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"No manual screen reader testing has been carried out."}]," Automated checks catch roughly a third of accessibility problems. A full NVDA and VoiceOver pass over search, listings, enquiry and the dealership pages is scheduled and has not happened."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Vehicle photography is not on the site yet"}],", so alt text on real images has not been tested at scale. Generated alt text from the vehicle details is built, and dealerships can override it per image."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Some sections are not built."}]," The dealership portal and the agency site do not exist yet, so nothing is claimed about them."]}],"$L2"]}],"$L3","$L4","$L5","$L6","$L7","$L8"]}]]}],null,"$L9"]}],"isPartial":"$@a","staleTime":"$b","varyParams":null},{"rsc":"$Lc","isPartial":"$@d","staleTime":"$b","varyParams":null},{"rsc":"$Le","isPartial":"$@f","staleTime":"$b","varyParams":"$10"}],"isUpgradeableISRFallback":false,"a":"$@11","rootVaryParams":null,"needsRuntimeRequest":"$@12"}
