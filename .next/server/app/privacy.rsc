25:["$","div",null,{"className":"mt-12 flex flex-col gap-4 border-t border-line pt-6 text-xs text-ink-muted sm:flex-row sm:items-center sm:justify-between","children":[["$","p",null,{"children":["© ",2026," Rynet. All rights reserved."]}],["$","p",null,{"className":"measure","children":"Vehicle prices and specifications are supplied by the selling dealership. Finance figures shown anywhere on this site are estimates, not quotations."}]]}]
