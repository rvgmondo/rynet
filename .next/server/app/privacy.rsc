27:["$","li",null,{"children":[["$","strong",null,{"children":"Nobody else."}]," We do not sell personal information, and we do not share it for anyone else's marketing."]}]
28:["$","h2",null,{"children":"Where it is kept"}]
29:["$","p",null,{"children":"On servers in South Africa. Where a provider processes information outside the country, we only use one that offers protection comparable to POPIA."}]
2a:["$","h2",null,{"children":"How long we keep it"}]
2b:["$","ul",null,{"children":[["$","li",null,{"children":[["$","strong",null,{"children":"Enquiries:"}]," three years from the date you sent one, so a dealership can answer a query about a past deal and so we can resolve a complaint."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Consent records:"}]," for as long as we hold the information they relate to, plus three years. A consent record is the evidence of what you agreed to, and deleting it would leave us unable to demonstrate that you agreed at all."]}],["$","li",null,{"children":[["$","strong",null,{"children":"Accounts:"}]," until you delete yours, or after three years of no sign-in."]}]]}]
2c:["$","p",null,{"children":"Deletion is automatic when a retention period ends. It is not a manual clean-up."}]
2d:["$","h2",null,{"children":"Your rights"}]
2e:["$","p",null,{"children":"Under POPIA you can:"}]
2f:["$","ul",null,{"children":[["$","li",null,{"children":"Ask what personal information we hold about you, and get a copy."}],["$","li",null,{"children":"Have anything inaccurate corrected."}],["$","li",null,{"children":"Have your information deleted, where we are not required to keep it."}],["$","li",null,{"children":"Object to processing, and withdraw consent you have given."}],["$","li",null,{"children":"Complain to the Information Regulator. You do not have to come to us first, though it is usually quicker."}]]}]
30:["$","p",null,{"children":["Email ",["$","a",null,{"href":"mailto:privacy@rynet.co.za","children":"privacy@rynet.co.za"}]," and we will respond within 30 days. We may ask you to confirm who you are first, because handing someone else's information to whoever asks is its own breach."]}]
31:["$","h2",null,{"children":"Security"}]
32:["$","p",null,{"children":"Everything travels over HTTPS. Passwords are stored as a salted PBKDF2-HMAC-SHA256 hash and are not recoverable, by us or by anyone else. Sensitive fields, including a vehicle's full VIN, are never returned to a public request and never to a dealership other than the one selling the vehicle. Access to the systems holding personal information is limited to staff who need it."}]
33:["$","p",null,{"children":"Dealership data is isolated: a dealership can only ever read its own leads and stock. That is enforced in the database query rather than in the interface, and it is tested on every change by a suite that signs in as one dealership and tries to reach another."}]
34:["$","p",null,{"children":[["$","strong",null,{"children":"What we have not done yet."}]," Two-factor authentication is not available on any account. Personal information is not encrypted at rest beyond the protection the server itself provides. We would rather tell you that than describe a control we have not built."]}]
35:["$","h2",null,{"children":"If something goes wrong"}]
36:["$","p",null,{"children":"If personal information is accessed by someone who should not have it, we will notify the Information Regulator and everyone affected, as POPIA requires, and tell you plainly what happened and what to do about it."}]
37:["$","h2",null,{"children":"Changes"}]
38:["$","p",null,{"children":"If this notice changes materially we will say so on the site. Consent you gave under a previous version stays linked to that version, so what you agreed to does not change retroactively."}]
39:["$","h2",null,{"children":"The Information Regulator"}]
