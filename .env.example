# Copy to .env and fill in. Never commit real secrets.

# Database. SQLite by default: one file, which is what the cPanel host supports.
# Set a postgres:// URL instead and the adapter switches with no code change.
DATABASE_URI=file:./rynet.db

# Signs JWTs and encrypts stored secrets. Generate with:
#   node -e "console.log(require(0+String.fromCharCode(39)+0)) "
PAYLOAD_SECRET=change-me

# Public base URL, no trailing slash. Baked in at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloudflare R2, where vehicle photography lives. Left blank, uploads stay on local disk,
# which is fine in development and wrong in production: shared hosting runs out of inodes
# long before it runs out of disk.
NEXT_PUBLIC_MEDIA_HOSTNAME=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Email. cPanel SMTP. Leave SMTP_HOST blank in development and Payload logs to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rynet.co.za

# PayFast. Sandbox credentials in development.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=true
