# Copy to .env and fill in. Never commit real secrets.

# Database. SQLite by default: one file, which is what the cPanel host supports.
# Set a postgres:// URL instead and the adapter switches with no code change.
DATABASE_URI=file:./rynet.db

# Signs JWTs and encrypts stored secrets. Generate with:
#   node -e "console.log(require(0+String.fromCharCode(39)+0)) "
PAYLOAD_SECRET=change-me

# Public base URL, no trailing slash. Baked in at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Extra origins allowed to authenticate with the session cookie, comma separated.
# NEXT_PUBLIC_SERVER_URL is baked into the build, so one build cannot answer on two origins
# without this. Set SERVER_URL when the same build is served somewhere else, a staging
# hostname or a test port, or every page will report nobody as signed in.
# SERVER_URL=
# TRUSTED_ORIGINS=

# Cloudflare R2, where vehicle photography lives. Left blank, uploads stay on local disk,
# which is fine in development and wrong in production: shared hosting runs out of inodes
# long before it runs out of disk.
NEXT_PUBLIC_MEDIA_HOSTNAME=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Email. cPanel SMTP. Leave SMTP_HOST blank in development and Payload logs to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=info@rynet.co.za

# Phone pushes (ntfy) when a dealer opens a mockup or a website lead comes in. The topic is the
# only credential: set it in cPanel's Setup Node.js App, never here. Blank means no pushes.
NTFY_TOPIC=

# PayFast. Sandbox credentials in development.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_SANDBOX=

# Two-factor. Leave unset until the platform admin and dealer principal accounts have enrolled
# at /account/two-factor. Setting it to true makes a second factor compulsory for those roles,
# and an account that has not enrolled cannot sign in at all.
RYNET_REQUIRE_2FA=true

# Posting to dealerships' Facebook Pages and Instagram (docs/SOCIAL-POSTING.md). Leave blank and
# the portal says posting is not switched on yet; nothing else changes.
META_APP_ID=
META_APP_SECRET=
# Only for an app set up with Facebook Login for Business. Blank uses the permission list.
META_CONFIG_ID=
# At least 32 random characters. Encrypts the Page tokens. Losing it means every Page reconnects.
SOCIAL_TOKEN_KEY=
# 1 logs what would be posted and posts nothing. Use it for the first days on the live site.
SOCIAL_DRY_RUN=
# Only when the site's own address is not the one the internet reaches it on.
PUBLIC_MEDIA_BASE=
